MODEL:

SETS:
    RES / r1, r2, r3 /;
    NODE / n1, n2, n3 /;

    RESNODE(RES,NODE): A, X;
    NODEATTR(NODE): BCRIT;
ENDSETS

DATA:
    A =
    1 1 0
    1 0 1
    0 1 1;

    BCRIT =
    1
    0
    0;
ENDDATA

MAX = @SUM(RESNODE(i,j): BCRIT(j) * A(i,j) * X(i,j));

@FOR(NODE(j):
    @SUM(RES(i): A(i,j) * X(i,j)) <= 1
);

@FOR(RES(i):
    @SUM(NODE(j): A(i,j) * X(i,j)) <= 1
);

@FOR(RESNODE(i,j):
    @BIN(X(i,j))
);

END